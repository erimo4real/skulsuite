# ── Public site URL ─────────────────────────────────────────────
# Used for canonical URLs, sitemap.xml and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── WhatsApp ────────────────────────────────────────────────────
# International format, digits only (e.g. 2348012345678).
# Leave empty to hide all WhatsApp CTAs until the number is confirmed.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Public contact details ──────────────────────────────────────
# Shown on the Contact page and footer. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ── Lead capture (optional) ─────────────────────────────────────
# If set, the demo/contact forms POST JSON to this endpoint
# (e.g. a Formspree/Getform URL). If empty, forms fall back to
# opening WhatsApp with a pre-filled, structured message.
NEXT_PUBLIC_FORM_ENDPOINT=

# ── Analytics (optional) ────────────────────────────────────────
# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Events tracked:
# page views, demo submissions, WhatsApp clicks, pricing views.
NEXT_PUBLIC_GA_ID=

# ── Internal review flag ────────────────────────────────────────
# Set to "true" while auditing content: shows "to be confirmed"
# markers next to every feature claim that is not yet verified
# against the real applications. Keep "false" in production.
NEXT_PUBLIC_SHOW_VERIFICATION_FLAGS=false
